# ---- Neon Database ----
DATABASE_URL=postgres://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_UPLOAD_FOLDER=wsa

# ---- Admin auth ----
# Secret used to sign the admin session JWT. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_JWT_SECRET=change-me-to-a-long-random-string

# ---- AI assistant (WallBot) + market news ----
# Kept server-side so the keys never ship to the browser.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
NEWS_API_KEY=
# Public site URL (sent to OpenRouter as the HTTP-Referer; used in the sitemap). Production default: https://wsfxacademy.com
SITE_URL=http://localhost:3000

# ---- Server ----
# Set to "production" when self-hosting (enables JSON logs). Vercel sets this automatically.
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed origins (the users + admin apps)
# Production default (when unset): https://wsfxacademy.com,https://www.wsfxacademy.com,https://admin.wsfxacademy.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ---- Google reviews (testimonials) ----
# Optional: the admin can save the key from the dashboard instead (Google Reviews page).
GOOGLE_PLACES_API_KEY=
# Secret for the daily review sync (Vercel Cron sends it automatically when set).
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=
